<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- 投屏常驻取帧：前台服务本身、Android 14+ 的 mediaProjection 类型，以及常驻通知。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <instrumentation android:name=".OcrChecks" android:targetPackage="local.jcc.probe" android:label="Read-only OCR fixture check" />
    <instrumentation android:name=".DeckChecks" android:targetPackage="local.jcc.probe" android:label="Isolated named deck checks" />
    <instrumentation android:name=".LineupChecks" android:targetPackage="local.jcc.probe" android:label="Read-only lineup fixture checks" />
    <application android:label="@string/app_name" android:icon="@drawable/jcc_icon" android:roundIcon="@drawable/jcc_icon" android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service android:name=".CaptureService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/capture_service" />
        </service>
        <!-- 投屏取帧通道：仅持有 MediaProjection 会话并出帧，不出现在无障碍服务列表里。 -->
        <service android:name=".ProjectionService" android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
